# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
DB_NAME=pranjal_crm

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Admin Credentials
# IMPORTANT: Use a strong, unique password. Never reuse across environments.
ADMIN_EMAIL=office@pranjalsarkar.com
ADMIN_PASSWORD=

# Direct Login Whitelist (Optional)
ADMIN_DIRECT_LOGIN_EMAIL=

# Blog Admin Panel Credentials (Required)
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=

# JWT Secret — generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Email & Verification API Keys
BREVO_API_KEY_OFFICE=
RECAPTCHA_SECRET_KEY=

# Cloudinary Media Storage (Required for Blog Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Force custom Google DNS (8.8.8.8) if network encounters DNS resolution issues
FORCE_CUSTOM_DNS=false

# Error Tracking (Optional)
# SENTRY_DSN=